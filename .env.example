# =============================================================================
# LLM Shield — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- LLM Provider ---
# Groq API key (required for production mode)
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Default Model ---
# Default model for primary LLM calls (Groq models via litellm)
SHIELD_DEFAULT_MODEL=groq/llama-3.1-70b-versatile

# --- Fallback Models ---
# Comma-separated list of fallback models (tried in order)
SHIELD_FALLBACK_MODELS=groq/llama-3.1-8b-instant,groq/gemma2-9b-it

# --- Retry / Repair Limits ---
SHIELD_MAX_RETRIES=3
SHIELD_MAX_REPAIRS=2
SHIELD_TIMEOUT_SECONDS=30

# --- Escalation ---
# Escalation mode: "in_memory" (Postman-accessible) or "webhook"
SHIELD_ESCALATION_MODE=in_memory

# Webhook URL (only used if SHIELD_ESCALATION_MODE=webhook)
SHIELD_ESCALATION_WEBHOOK_URL=http://localhost:8000/escalations/webhook

# --- Server ---
SHIELD_HOST=0.0.0.0
SHIELD_PORT=8000
SHIELD_LOG_LEVEL=info

# --- Chaos Testing (opt-in, double-locked) ---
# Set to true ONLY during deliberate chaos/resilience testing.
# Also requires X-Chaos-Mode: true header in HTTP requests.
# NEVER set this in production.
SHIELD_ALLOW_CHAOS=false
